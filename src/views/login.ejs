<%- include('./partials/header') %>
<section class="booking-page">
    <div class="route-header">
        <div class="route-header-content">
            <h1 class="route-name"><%= title %></h1>
            <p class="route-description">Sign in to manage your bookings.</p>
        </div>
    </div>

    <% if (error) { %>
        <p role="alert"><%= error %></p>
    <% } %>

    <form class="booking-form" method="POST" action="/login">
        <div class="form-group">
            <label class="form-label" for="email">Email</label>
            <input class="form-input" type="email" id="email" name="email" autocomplete="email" required>
        </div>

        <div class="form-group">
            <label class="form-label" for="password">Password</label>
            <input class="form-input" type="password" id="password" name="password" autocomplete="current-password" required>
        </div>

        <div class="form-actions">
            <button class="btn btn-primary" type="submit">Sign In</button>
        </div>
    </form>

    <p>Need an account? <a href="/register">Register</a></p>
</section>
<%- include('./partials/footer') %>
