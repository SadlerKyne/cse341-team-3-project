<%- include('./partials/header') %>

<section class="bookings-admin" id="users-admin" data-current-user-id="<%= user.id %>" data-is-admin="<%= user.role === 'admin' %>">
    <h1><%= title %></h1>
    <form id="users-filters">
        <label for="users-role">Role</label>
        <select id="users-role">
            <option value="">All</option>
            <option value="customer">Customer</option>
            <option value="admin">Admin</option>
        </select>
        <label for="users-q">Search</label>
        <input type="search" id="users-q" placeholder="Name, username, or email">
        <button type="submit">Search</button>
    </form>

    <p id="users-message">Loading users...</p>

    <table class="bookings-table">
        <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Username</th>
                <th scope="col">Email</th>
                <th scope="col">Role</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody id="users-list"></tbody>
    </table>

    <div class="pager">
        <button type="button" id="users-prev">Previous</button>
        <span id="users-page"></span>
        <button type="button" id="users-next">Next</button>
    </div>
</section>

<script src="/js/users-admin.js"></script>

<%- include('./partials/footer') %>
